{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "智云实验室学生端",
  "mainBinaryName": "zhiyun-student-client",
  "version": "0.1.0",
  "identifier": "com.zhiyun.student-client",
  "build": {
    "beforeBuildCommand": "",
    "frontendDist": "../student-dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "script-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "licenseFile": "./license/agreement.txt",
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
