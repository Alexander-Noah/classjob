# impeccable-live-ignore-end

# Smart Lab local runtime
.local/
**/.venv/
logs/
Backend/.local-dev-secrets.properties
Backend/target/
Backend/logs/
Backend/data/
monitoring/.env

# Monorepo-local metadata and generated artifacts
.nested-git-backup/
.worktrees/
.impeccable/
**/node_modules/
**/target/
**/dist/
**/.idea/
**/.vs/
**/__pycache__/
*.py[cod]
*.tmp
~$*

# Source archives are local backups and exceed GitHub's normal file limit
*.zip
