{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "教师监控客户端",
  "version": "0.1.0",
  "identifier": "com.zhiyun.teacher-monitor-desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "智云实验室教师端",
        "width": 560,
        "height": 620,
        "minHeight": 620,
        "minWidth": 560,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "script-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "licenseFile": "./license/agreement.txt",
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}