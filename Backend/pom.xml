<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>
    <groupId>org.example</groupId>
    <artifactId>smart-lab-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Smart Lab Backend Parent</name>
    <properties>
        <java.version>17</java.version>
        <archunit.version>1.4.1</archunit.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
    </properties>
    <modules>
        <module>legacy-app</module>
        <module>platform/kernel</module>
        <module>platform/security</module>
        <module>platform/web-support</module>
        <module>modules/identity-access</module>
        <module>modules/teaching-schedule</module>
        <module>modules/lab-resource</module>
        <module>modules/reservation</module>
        <module>modules/environment-readiness</module>
        <module>modules/teaching-coordination</module>
        <module>bridges/reservation-lab-resource-bridge</module>
        <module>bridges/coordination-schedule-bridge</module>
        <module>bridges/coordination-reservation-bridge</module>
        <module>bridges/coordination-environment-bridge</module>
        <module>integrations/academic-system</module>
        <module>app-host</module>
        <module>architecture-tests</module>
        <module>removal-tests/without-environment-readiness</module>
        <module>removal-tests/without-reservation</module>
        <module>removal-tests/without-academic-system</module>
    </modules>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
