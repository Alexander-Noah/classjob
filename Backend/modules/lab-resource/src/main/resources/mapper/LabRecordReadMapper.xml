<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.backend.labresource.adapter.out.persistence.LabRecordReadMapper">
    <resultMap id="labRecord"
               type="org.example.backend.labresource.application.port.out.LabRecord">
        <constructor>
            <idArg column="id" name="id" javaType="java.lang.Long"/>
            <arg column="lab_code" name="labCode" javaType="java.lang.String"/>
            <arg column="lab_name" name="labName" javaType="java.lang.String"/>
            <arg column="building" name="building" javaType="java.lang.String"/>
            <arg column="floor" name="floor" javaType="java.lang.String"/>
            <arg column="room_no" name="roomNo" javaType="java.lang.String"/>
            <arg column="lab_type" name="labType" javaType="java.lang.String"/>
            <arg column="capacity" name="capacity" javaType="java.lang.Integer"/>
            <arg column="manager_user_id" name="managerUserId" javaType="java.lang.Long"/>
            <arg column="open_status" name="openStatus" javaType="java.lang.String"/>
            <arg column="remark" name="remark" javaType="java.lang.String"/>
            <arg column="created_at" name="createdAt" javaType="java.time.LocalDateTime"/>
            <arg column="updated_at" name="updatedAt" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <sql id="ownedColumns">
        id,
        lab_code,
        lab_name,
        building,
        floor,
        room_no,
        lab_type,
        capacity,
        manager_user_id,
        open_status,
        remark,
        created_at,
        updated_at
    </sql>

    <select id="findAll" resultMap="labRecord">
        select <include refid="ownedColumns"/>
        from lab
        <where>
            <if test="managerUserId != null">
                manager_user_id = #{managerUserId}
            </if>
        </where>
        order by id asc
    </select>

    <select id="findById" resultMap="labRecord">
        select <include refid="ownedColumns"/>
        from lab
        where id = #{id}
    </select>
</mapper>
