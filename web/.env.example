# =============================
# 前端环境变量示例
# 使用方式：
# 1. 复制为 .env.development 或 .env.production。
# 2. 按本机后端地址、部署域名修改对应值。
# 3. 修改后重启 Vite 开发服务。
# =============================

# API 运行模式：
# - server：请求真实后端接口。
# - mock：使用前端本地模拟数据。
VITE_API_MODE=server

# 前端请求后端的基础路径。
# 开发环境建议保持 /api，由 vite.config.js 代理到 VITE_API_PROXY_TARGET。
# 生产环境如果前后端同域，也可以继续使用 /api。
VITE_API_BASE_URL=/api

# Vite 开发代理的后端地址。
# 如果后端不是 8080，或后端在其他机器上运行，改这里。
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# 二维码、分享链接等场景使用的前端公开访问地址。
# 手机扫码测试时必须填写手机能访问到的电脑局域网地址，例如 http://192.168.1.10:5173。
VITE_PUBLIC_APP_URL=

# Vite 开发服务监听地址。
# - 0.0.0.0：允许同一局域网访问。
# - 127.0.0.1：只允许本机访问。
VITE_DEV_HOST=0.0.0.0

# API 请求超时时间，单位毫秒。
VITE_API_TIMEOUT=10000